# Normalize text files in the repository.
* text=auto

# Enforce LF for source code and common text assets.
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.html text eol=lf
*.xml text eol=lf

# Keep Windows scripts in CRLF form for native shells.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
