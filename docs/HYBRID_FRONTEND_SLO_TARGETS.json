{
  "service": "hybrid_frontend_migration",
  "version": "2026-02-25",
  "owner": {
    "team": "platform-oncall",
    "channel": "#okr-oncall"
  },
  "dashboard": {
    "name": "Hybrid Frontend Cutover",
    "refresh_seconds": 60,
    "windows": [
      {
        "name": "5m",
        "duration_minutes": 5
      },
      {
        "name": "1h",
        "duration_minutes": 60
      },
      {
        "name": "24h",
        "duration_minutes": 1440
      },
      {
        "name": "7d",
        "duration_minutes": 10080
      }
    ]
  },
  "slos": [
    {
      "id": "login_success_rate",
      "journey": "User login from spa-web through spa-bff",
      "type": "success_rate",
      "unit": "percent",
      "target": 99.0,
      "measurement_window_minutes": 60,
      "queries": {
        "good": "sum(rate(spa_bff_requests_total{route=\"/v1/auth/login\",status=~\"2..\"}[5m]))",
        "total": "sum(rate(spa_bff_requests_total{route=\"/v1/auth/login\"}[5m]))"
      },
      "alerts": {
        "warning_below": 99.0,
        "critical_below": 98.0,
        "for_minutes": 15
      }
    },
    {
      "id": "atlas_read_success_rate",
      "journey": "Atlas snapshot read from spa-web to backend via spa-bff",
      "type": "success_rate",
      "unit": "percent",
      "target": 99.0,
      "measurement_window_minutes": 60,
      "queries": {
        "good": "sum(rate(spa_bff_requests_total{route=\"/v1/read/atlas/snapshot\",status=~\"2..\"}[5m]))",
        "total": "sum(rate(spa_bff_requests_total{route=\"/v1/read/atlas/snapshot\"}[5m]))"
      },
      "alerts": {
        "warning_below": 99.0,
        "critical_below": 98.0,
        "for_minutes": 15
      }
    },
    {
      "id": "atlas_read_p95_latency_ms",
      "journey": "Atlas snapshot read latency from spa-bff perspective",
      "type": "latency_p95",
      "unit": "milliseconds",
      "target": 1200,
      "measurement_window_minutes": 60,
      "queries": {
        "value": "histogram_quantile(0.95, sum(rate(spa_bff_request_duration_ms_bucket{route=\"/v1/read/atlas/snapshot\"}[5m])) by (le))"
      },
      "alerts": {
        "warning_above": 1400,
        "critical_above": 1800,
        "for_minutes": 15
      }
    },
    {
      "id": "timer_mutation_success_rate",
      "journey": "Timer start/stop mutation from spa-web to backend via spa-bff",
      "type": "success_rate",
      "unit": "percent",
      "target": 99.0,
      "measurement_window_minutes": 60,
      "queries": {
        "good": "sum(rate(spa_bff_requests_total{route=~\"/v1/timer/(start|stop)\",status=~\"2..\"}[5m]))",
        "total": "sum(rate(spa_bff_requests_total{route=~\"/v1/timer/(start|stop)\"}[5m]))"
      },
      "alerts": {
        "warning_below": 99.0,
        "critical_below": 98.0,
        "for_minutes": 15
      }
    },
    {
      "id": "timer_mutation_p95_latency_ms",
      "journey": "Timer mutation latency from spa-bff perspective",
      "type": "latency_p95",
      "unit": "milliseconds",
      "target": 1500,
      "measurement_window_minutes": 60,
      "queries": {
        "value": "histogram_quantile(0.95, sum(rate(spa_bff_request_duration_ms_bucket{route=~\"/v1/timer/(start|stop)\"}[5m])) by (le))"
      },
      "alerts": {
        "warning_above": 1800,
        "critical_above": 2200,
        "for_minutes": 15
      }
    },
    {
      "id": "report_open_success_rate",
      "journey": "SPA report bridge open to Streamlit via /bridge/streamlit",
      "type": "success_rate",
      "unit": "percent",
      "target": 99.0,
      "measurement_window_minutes": 60,
      "queries": {
        "good": "sum(rate(spa_web_bridge_requests_total{route=\"/bridge/streamlit\",status=~\"3..\"}[5m]))",
        "total": "sum(rate(spa_web_bridge_requests_total{route=\"/bridge/streamlit\"}[5m]))"
      },
      "alerts": {
        "warning_below": 99.0,
        "critical_below": 98.0,
        "for_minutes": 15
      }
    }
  ]
}
