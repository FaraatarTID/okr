# Disposable Darkube pre-release configuration.
# Synthetic data only. Generate every placeholder in the Darkube console.
# Never use this file for production or a real customer environment.

OKR_ENV=prerelease
OKR_RUNTIME_ENV=prerelease
NODE_ENV=production
OKR_DEPLOYMENT_PROFILE=single_tenant_saas
OKR_SAAS_MODE=true
OKR_DATA_ACCESS_MODE=database
OKR_ENVIRONMENT_ID=okr-prerelease
OKR_CUSTOMER_ID=synthetic-prerelease

# Private Darkube managed PostgreSQL address. Replace only the credentials/host
# with the disposable synthetic database values created in Darkube.
OKR_DATABASE_URL=postgresql+psycopg2://okr_app:GENERATE_IN_DARKUBE@okr-prerelease-postgres.internal:5432/okr
OKR_BACKUP_PROVIDER=deferred
OKR_BACKUP_SCHEDULE=deferred

# Supabase HTTPS fallback is intentionally disabled.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

OKR_BACKEND_API_URL=http://backend-api:8100
OKR_BACKEND_SERVICE_TOKEN=GENERATE_IN_DARKUBE
OKR_BACKEND_SIGNING_SECRET=GENERATE_IN_DARKUBE
OKR_BOOTSTRAP_ADMIN_PASSWORD=GENERATE_IN_DARKUBE
OKR_BACKEND_ENFORCE_TOKEN=true
OKR_BACKEND_ENFORCE_REQUEST_SIGNING=true
OKR_BACKEND_PROXY_MUTATIONS=true
OKR_BACKEND_PROXY_READS=true
OKR_BACKEND_SECURITY_STATE_BACKEND=database
OKR_BACKEND_SECURITY_STATE_REDIS_URL=
OKR_BACKEND_SECURITY_STATE_REDIS_PREFIX=okr:security
OKR_ALLOW_LOCAL_MUTATION_FALLBACK=false
OKR_ALLOW_LOCAL_READ_FALLBACK=false
OKR_ALLOW_LOCAL_BACKEND_FALLBACK=false
OKR_AUTH_ALLOW_THROTTLE_FAIL_OPEN=false
OKR_ENFORCE_STRONG_PASSWORD_POLICY=true
OKR_BACKEND_DEFAULT_ACTOR=system
OKR_BACKEND_HOST=0.0.0.0
OKR_BACKEND_PORT=8100
OKR_BACKEND_API_WORKERS=1
OKR_BACKEND_API_REPLICAS=1
OKR_BACKEND_WORKER_REPLICAS=1
OKR_BACKEND_BIND_ADDRESS=127.0.0.1
OKR_BACKEND_WORKER_POLL_SECONDS=2
OKR_STRICT_RUNTIME_PREFLIGHT=true

PDF_METHOD=chromium
PDFSHIFT_API_KEY=
ALLOW_EXTERNAL_AI=false
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

BFF_PORT=3001
SPA_BFF_REPLICAS=1
SPA_WEB_REPLICAS=1
BFF_SESSION_SECRET=GENERATE_IN_DARKUBE
BFF_SESSION_TTL_SECONDS=28800
BFF_COOKIE_SECURE=true
BFF_PUBLIC_ORIGIN=https://okr-prerelease-bff.invalid
BFF_LOG_LEVEL=info
OKR_BACKEND_SECURITY_STATE_BACKEND=database

# These are runtime tuning defaults and contain no credentials.
BFF_REQUEST_TIMEOUT_MS=120000
OKR_BACKEND_JOB_USER_WINDOW_SECONDS=60
OKR_BACKEND_JOB_USER_MAX_REQUESTS=8
OKR_BACKEND_JOB_USER_DAILY_MAX_REQUESTS=200
OKR_BACKEND_JOB_USER_PENDING_MAX_REQUESTS=3
OKR_BACKEND_JOB_TEAM_WINDOW_SECONDS=60
OKR_BACKEND_JOB_TEAM_MAX_REQUESTS=60
OKR_BACKEND_JOB_TEAM_DAILY_MAX_REQUESTS=1200
OKR_BACKEND_JOB_TEAM_PENDING_MAX_REQUESTS=40
OKR_BACKEND_JOB_BACKOFF_BASE_SECONDS=3
OKR_BACKEND_JOB_RETENTION_DAYS=14
OKR_BACKEND_AUDIT_RETENTION_DAYS=365
AUTH_USER_WINDOW_SECONDS=300
AUTH_USER_MAX_ATTEMPTS=5
AUTH_IP_WINDOW_SECONDS=300
AUTH_IP_MAX_ATTEMPTS=20
AUTH_LOCKOUT_SECONDS=900
