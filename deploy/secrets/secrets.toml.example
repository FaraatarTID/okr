# Streamlit secrets template. Copy to deploy/secrets/secrets.toml and DO NOT commit actual credentials.
# Mount at /app/streamlit_app/.streamlit/secrets.toml in docker-compose or via Kubernetes Secret.

# Example: PDF service
# PDFShift is the only supported PDF binary provider.
pdfshift_api_key = ""
PDF_METHOD = "pdfshift"
ALLOW_EXTERNAL_AI = false  # set true only for explicitly approved environments
OKR_STRICT_RUNTIME_PREFLIGHT = true

# AI Provider
AI_PROVIDER = "gemini"  # gemini | openai_compatible

# Gemini provider settings
GEMINI_API_KEY = ""
GEMINI_MODEL = "gemini-flash-latest"

# OpenAI-compatible provider settings (Ollama / LM Studio / vLLM / gateway)
# AI_BASE_URL = "http://localhost:11434"
# AI_MODEL = "llama3.1"
# AI_API_KEY = ""  # optional for local endpoints, required for hosted gateways

[database]
# Required: Supabase PostgreSQL URL
url = "postgresql+psycopg2://okr_app.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"

# Note: backend API/worker settings are environment variables (not secrets keys):
# - OKR_BACKEND_API_URL
# - OKR_BACKEND_SERVICE_TOKEN (required when backend API token enforcement is enabled)
# - OKR_BACKEND_SIGNING_SECRET (recommended for signed internal requests)
# - OKR_BOOTSTRAP_ADMIN_PASSWORD (required in production; env-only bootstrap source; min 12 chars with upper/lower/number/symbol)
# - OKR_BACKEND_PROXY_MUTATIONS (recommended: true)
# - OKR_BACKEND_SECURITY_STATE_BACKEND (production: database or redis)
# - OKR_BACKEND_SECURITY_STATE_REDIS_URL (required when backend=redis)
# - OKR_BACKEND_SECURITY_STATE_REDIS_PREFIX (optional namespace; default: okr:security)
# - OKR_ALLOW_LOCAL_MUTATION_FALLBACK (keep false/unset in production)
# - OKR_ALLOW_LOCAL_READ_FALLBACK (keep false/unset in production)
# - OKR_ENABLE_DIRECT_DB_RESTORE (keep false/unset in production; enable only for controlled non-production restore operations)
# - OKR_AUTH_ALLOW_THROTTLE_FAIL_OPEN (keep false/unset in production; production runtime does not allow fail-open bypass)
# - OKR_ENFORCE_STRONG_PASSWORD_POLICY (recommended true in production; enforces strong passwords in API + CRUD create/reset paths)
# - OKR_BACKEND_PORT
# - OKR_BACKEND_WORKER_POLL_SECONDS
# - OKR_BACKEND_JOB_USER_WINDOW_SECONDS / OKR_BACKEND_JOB_USER_MAX_REQUESTS / OKR_BACKEND_JOB_USER_DAILY_MAX_REQUESTS
# - OKR_BACKEND_JOB_USER_PENDING_MAX_REQUESTS (max pending/running async jobs per user)
# - OKR_BACKEND_JOB_TEAM_WINDOW_SECONDS / OKR_BACKEND_JOB_TEAM_MAX_REQUESTS / OKR_BACKEND_JOB_TEAM_DAILY_MAX_REQUESTS
# - OKR_BACKEND_JOB_TEAM_PENDING_MAX_REQUESTS (max pending/running async jobs per team)
# - OKR_BACKEND_JOB_BACKOFF_BASE_SECONDS (minimum spacing between submits per actor; `429` retry metadata uses this)
