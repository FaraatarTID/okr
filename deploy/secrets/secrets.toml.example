# Streamlit secrets template. Copy to deploy/secrets/secrets.toml and DO NOT commit actual credentials.
# Mount at /app/streamlit_app/.streamlit/secrets.toml in docker-compose or via Kubernetes Secret.

# Example: PDF service
pdfshift_api_key = ""
PDF_METHOD = "pdfshift"  # or "pdfkit"

# Example: Google API
[google]
service_account_key = ""  # JSON content or path if your code supports it

# Custom app settings
[app]
admin_emails = ["admin@yourcompany.com"]

[database]
# Option A: full URL (preferred)
# url = "postgresql+psycopg2://okr:okrpass@db-host:5432/okr"

# Option B: build from parts (used only if url is not set)
driver = "postgresql+psycopg2"
host = "db-host"
port = 5432
name = "okr"
user = "okr"
password = "okrpass"
