# Port that Streamlit will listen on inside the container
PORT=8501

# Port exposed on the host (external)
HOST_PORT=8501

# If serving behind a subpath (e.g. https://example.com/okr), set this to "okr"
# Leave empty when using a dedicated subdomain
BASE_URL_PATH=

# Optional: PostgreSQL if you want to move beyond Google Drive/SQLite
# These control the companion Postgres container in docker-compose.postgres.yml
POSTGRES_DB=okr
POSTGRES_USER=okr
POSTGRES_PASSWORD=okrpass
PG_HOST_PORT=5432
