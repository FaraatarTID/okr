# Port that Streamlit will listen on inside the container
PORT=8501

# Port exposed on the host (external)
HOST_PORT=8501

# If serving behind a subpath (e.g. https://example.com/okr), set this to "okr"
# Leave empty when using a dedicated subdomain
BASE_URL_PATH=

# Strict production behavior:
# - disables Google Sheets sync
# - requires non-SQLite DB
PRODUCTION=true

# Recommended for production: managed PostgreSQL connection URL
# Example:
# OKR_DATABASE_URL=postgresql+psycopg2://okr_user:strong_password@db.company.net:5432/okr
OKR_DATABASE_URL=

# Optional fallback alias for DB URL
DATABASE_URL=

# Optional: tune authentication lockouts/rate limits
AUTH_USER_WINDOW_SECONDS=300
AUTH_USER_MAX_ATTEMPTS=5
AUTH_IP_WINDOW_SECONDS=300
AUTH_IP_MAX_ATTEMPTS=20
AUTH_LOCKOUT_SECONDS=900

# Optional: pull a specific image tag instead of local build output
# IMAGE=ghcr.io/your-org/okr-streamlit:latest

# Optional: PostgreSQL if you want to move beyond Google Drive/SQLite
# These control the companion Postgres container in docker-compose.postgres.yml
POSTGRES_DB=okr
POSTGRES_USER=okr
POSTGRES_PASSWORD=okrpass
PG_HOST_PORT=5432
