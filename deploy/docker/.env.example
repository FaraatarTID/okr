# Required: Supabase PostgreSQL connection URL
# Example:
# OKR_DATABASE_URL=postgresql+psycopg2://okr_app.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
OKR_DATABASE_URL=
# Data access mode:
# - database (default): direct SQLAlchemy/Postgres socket
# - supabase_api: HTTPS-only Supabase REST mode (experimental; currently login-focused)
OKR_DATA_ACCESS_MODE=database
# Deployment profile: set `saas` for cloud multi-tenant deployments. SaaS
# startup rejects every data-access mode other than `database`.
OKR_DEPLOYMENT_PROFILE=self_hosted

# Optional: Supabase HTTPS API access (works on port 443 when DB ports are blocked)
# Example: https://your-project-ref.supabase.co
SUPABASE_URL=
# Use service role key only in trusted server/runtime contexts.
SUPABASE_SERVICE_ROLE_KEY=
# Optional client-safe key for browser-limited flows.
SUPABASE_ANON_KEY=

# Optional: internal backend API + worker wiring (recommended)
OKR_BACKEND_API_URL=http://backend-api:8100
OKR_BACKEND_SERVICE_TOKEN=CHANGE_ME_SHARED_TOKEN
OKR_BACKEND_SIGNING_SECRET=CHANGE_ME_STRONG_SIGNING_KEY
# Required in production: secure initial admin bootstrap password (must be strong)
OKR_BOOTSTRAP_ADMIN_PASSWORD=
OKR_BACKEND_ENFORCE_REQUEST_SIGNING=true
OKR_BACKEND_PROXY_MUTATIONS=true
OKR_BACKEND_PROXY_READS=true
# Use a distributed backend in production: database (default) or redis
OKR_BACKEND_SECURITY_STATE_BACKEND=database
OKR_BACKEND_SECURITY_STATE_REDIS_URL=
OKR_BACKEND_SECURITY_STATE_REDIS_PREFIX=okr:security
# Security state database pooling tuning (only active when using database backend and USE_NULL_POOL is false)
# OKR_BACKEND_SECURITY_STATE_DB_USE_NULL_POOL=true
# OKR_BACKEND_SECURITY_STATE_DB_POOL_SIZE=5
# OKR_BACKEND_SECURITY_STATE_DB_MAX_OVERFLOW=5
# OKR_BACKEND_SECURITY_STATE_DB_POOL_TIMEOUT=30
# OKR_BACKEND_SECURITY_STATE_DB_POOL_RECYCLE=1800
OKR_ALLOW_LOCAL_MUTATION_FALLBACK=false
OKR_ALLOW_LOCAL_READ_FALLBACK=false
OKR_ALLOW_LOCAL_BACKEND_FALLBACK=false
OKR_AUTH_ALLOW_THROTTLE_FAIL_OPEN=false
OKR_ENFORCE_STRONG_PASSWORD_POLICY=true
OKR_BACKEND_DEFAULT_ACTOR=system
OKR_BACKEND_PORT=8100
OKR_BACKEND_HOST_PORT=8100
OKR_BACKEND_BIND_ADDRESS=127.0.0.1
OKR_BACKEND_WORKER_POLL_SECONDS=2
OKR_BACKEND_ENFORCE_TOKEN=true
OKR_BACKEND_JOB_USER_WINDOW_SECONDS=60
OKR_BACKEND_JOB_USER_MAX_REQUESTS=8
OKR_BACKEND_JOB_USER_DAILY_MAX_REQUESTS=200
OKR_BACKEND_JOB_USER_PENDING_MAX_REQUESTS=3
OKR_BACKEND_JOB_TEAM_WINDOW_SECONDS=60
OKR_BACKEND_JOB_TEAM_MAX_REQUESTS=60
OKR_BACKEND_JOB_TEAM_DAILY_MAX_REQUESTS=1200
OKR_BACKEND_JOB_TEAM_PENDING_MAX_REQUESTS=40
OKR_BACKEND_JOB_BACKOFF_BASE_SECONDS=3
OKR_BACKEND_JOB_RETENTION_DAYS=14
OKR_BACKEND_AUDIT_RETENTION_DAYS=365
OKR_BACKEND_JOB_PRUNE_INTERVAL_SECONDS=300
OKR_BACKEND_JOB_PRUNE_BATCH_SIZE=200

# PDF and AI policy defaults
PDF_METHOD=pdfshift
PDFSHIFT_API_KEY=
ALLOW_EXTERNAL_AI=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=120
OKR_STRICT_RUNTIME_PREFLIGHT=true

# Optional: tune authentication lockouts/rate limits
AUTH_USER_WINDOW_SECONDS=300
AUTH_USER_MAX_ATTEMPTS=5
AUTH_IP_WINDOW_SECONDS=300
AUTH_IP_MAX_ATTEMPTS=20
AUTH_LOCKOUT_SECONDS=900

# Optional: pull a specific backend image tag instead of local build output
# IMAGE=ghcr.io/your-org/okr-backend:latest

# SPA BFF runtime (default stack)
BFF_PORT=3001
SPA_BFF_HOST_PORT=3001
SPA_BFF_BIND_ADDRESS=127.0.0.1
BFF_REQUEST_TIMEOUT_MS=120000
BFF_SESSION_SECRET=CHANGE_ME_BFF_SESSION_SECRET
BFF_SESSION_TTL_SECONDS=28800
BFF_COOKIE_SECURE=true
BFF_LOG_LEVEL=info
# Optional image override for BFF
# SPA_BFF_IMAGE=ghcr.io/your-org/okr-spa-bff:latest

# SPA web runtime (default stack)
SPA_WEB_HOST_PORT=3000
SPA_WEB_BIND_ADDRESS=127.0.0.1
BFF_PUBLIC_ORIGIN=http://spa-bff:3001
# Optional image override for SPA web
# SPA_WEB_IMAGE=ghcr.io/your-org/okr-spa-web:latest
