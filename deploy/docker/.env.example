# Port that Streamlit will listen on inside the container
PORT=8501

# Port exposed on the host (external)
HOST_PORT=8501

# If serving behind a subpath (e.g. https://example.com/okr), set this to "okr"
# Leave empty when using a dedicated subdomain
BASE_URL_PATH=

# Required: Supabase PostgreSQL connection URL
# Example:
# OKR_DATABASE_URL=postgresql+psycopg2://okr_app.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
OKR_DATABASE_URL=

# Optional: internal backend API + worker wiring (recommended)
OKR_BACKEND_API_URL=http://backend-api:8100
OKR_BACKEND_SERVICE_TOKEN=CHANGE_ME_SHARED_TOKEN
OKR_BACKEND_SIGNING_SECRET=CHANGE_ME_STRONG_SIGNING_KEY
# Required in production: secure initial admin bootstrap password (must be strong)
OKR_BOOTSTRAP_ADMIN_PASSWORD=
OKR_BACKEND_ENFORCE_REQUEST_SIGNING=true
OKR_BACKEND_PROXY_MUTATIONS=true
# Use a distributed backend in production: database (default) or redis
OKR_BACKEND_SECURITY_STATE_BACKEND=database
OKR_BACKEND_SECURITY_STATE_REDIS_URL=
OKR_BACKEND_SECURITY_STATE_REDIS_PREFIX=okr:security
OKR_ALLOW_LOCAL_BACKEND_FALLBACK=false
OKR_AUTH_ALLOW_THROTTLE_FAIL_OPEN=false
OKR_ENFORCE_STRONG_PASSWORD_POLICY=true
OKR_BACKEND_DEFAULT_ACTOR=system
OKR_BACKEND_PORT=8100
OKR_BACKEND_HOST_PORT=8100
OKR_BACKEND_BIND_ADDRESS=127.0.0.1
OKR_BACKEND_WORKER_POLL_SECONDS=2
OKR_BACKEND_ENFORCE_TOKEN=true
OKR_BACKEND_JOB_USER_WINDOW_SECONDS=60
OKR_BACKEND_JOB_USER_MAX_REQUESTS=8
OKR_BACKEND_JOB_USER_DAILY_MAX_REQUESTS=200
OKR_BACKEND_JOB_TEAM_WINDOW_SECONDS=60
OKR_BACKEND_JOB_TEAM_MAX_REQUESTS=60
OKR_BACKEND_JOB_TEAM_DAILY_MAX_REQUESTS=1200

# PDF and AI policy defaults
PDF_METHOD=pdfshift
PDFSHIFT_API_KEY=
ALLOW_EXTERNAL_AI=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
OKR_STRICT_RUNTIME_PREFLIGHT=true

# Optional: tune authentication lockouts/rate limits
AUTH_USER_WINDOW_SECONDS=300
AUTH_USER_MAX_ATTEMPTS=5
AUTH_IP_WINDOW_SECONDS=300
AUTH_IP_MAX_ATTEMPTS=20
AUTH_LOCKOUT_SECONDS=900

# Optional: pull a specific image tag instead of local build output
# IMAGE=ghcr.io/your-org/okr-streamlit:latest
