# Company deployment template for okr.mycompany.com
# Copy to deploy/docker/.env and replace values marked CHANGE_ME.

# Supabase PostgreSQL (required)
# IMPORTANT: if password has special characters, URL-encode it.
OKR_DATABASE_URL=postgresql+psycopg2://okr_app.CHANGE_ME_PROJECT_REF:CHANGE_ME_PASSWORD@aws-0-CHANGE_ME_REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Optional: Supabase HTTPS API access (port 443 fallback path)
SUPABASE_URL=https://CHANGE_ME_PROJECT_REF.supabase.co
# Server-side only (do not expose to browser clients)
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SUPABASE_SERVICE_ROLE_KEY
# Optional client-safe key
SUPABASE_ANON_KEY=

# Internal backend API/worker
OKR_BACKEND_API_URL=http://backend-api:8100
OKR_BACKEND_SERVICE_TOKEN=CHANGE_ME_STRONG_SHARED_TOKEN
OKR_BACKEND_SIGNING_SECRET=CHANGE_ME_STRONG_SIGNING_KEY
OKR_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_BOOTSTRAP_PASSWORD
OKR_BACKEND_ENFORCE_REQUEST_SIGNING=true
OKR_BACKEND_PROXY_MUTATIONS=true
OKR_BACKEND_PROXY_READS=true
# Production distributed security-state backend: database (default) or redis
OKR_BACKEND_SECURITY_STATE_BACKEND=database
OKR_BACKEND_SECURITY_STATE_REDIS_URL=
OKR_BACKEND_SECURITY_STATE_REDIS_PREFIX=okr:security
OKR_ALLOW_LOCAL_BACKEND_FALLBACK=false
OKR_AUTH_ALLOW_THROTTLE_FAIL_OPEN=false
OKR_ENFORCE_STRONG_PASSWORD_POLICY=true
OKR_BACKEND_DEFAULT_ACTOR=system
OKR_BACKEND_PORT=8100
OKR_BACKEND_HOST_PORT=8100
OKR_BACKEND_BIND_ADDRESS=127.0.0.1
OKR_BACKEND_WORKER_POLL_SECONDS=2
OKR_BACKEND_ENFORCE_TOKEN=true
OKR_BACKEND_JOB_USER_WINDOW_SECONDS=60
OKR_BACKEND_JOB_USER_MAX_REQUESTS=8
OKR_BACKEND_JOB_USER_DAILY_MAX_REQUESTS=200
OKR_BACKEND_JOB_USER_PENDING_MAX_REQUESTS=3
OKR_BACKEND_JOB_TEAM_WINDOW_SECONDS=60
OKR_BACKEND_JOB_TEAM_MAX_REQUESTS=60
OKR_BACKEND_JOB_TEAM_DAILY_MAX_REQUESTS=1200
OKR_BACKEND_JOB_TEAM_PENDING_MAX_REQUESTS=40
OKR_BACKEND_JOB_BACKOFF_BASE_SECONDS=3

# PDF + AI policy
PDF_METHOD=pdfshift
PDFSHIFT_API_KEY=CHANGE_ME_PDFSHIFT_KEY
ALLOW_EXTERNAL_AI=false
AI_PROVIDER=openai_compatible
AI_BASE_URL=http://CHANGE_ME_INTERNAL_LLM:11434
AI_MODEL=llama3.1
AI_API_KEY=
OKR_STRICT_RUNTIME_PREFLIGHT=true

# Authentication throttling defaults
AUTH_USER_WINDOW_SECONDS=300
AUTH_USER_MAX_ATTEMPTS=5
AUTH_IP_WINDOW_SECONDS=300
AUTH_IP_MAX_ATTEMPTS=20
AUTH_LOCKOUT_SECONDS=900

# Optional fixed backend image tag (recommended for predictable rollback)
# IMAGE=ghcr.io/mycompany/okr-backend:2026-02-14

# SPA BFF runtime (default stack)
BFF_PORT=3001
SPA_BFF_HOST_PORT=3001
SPA_BFF_BIND_ADDRESS=127.0.0.1
BFF_REQUEST_TIMEOUT_MS=90000
BFF_LOG_LEVEL=info
# SPA_BFF_IMAGE=ghcr.io/mycompany/okr-spa-bff:2026-02-25

# SPA web runtime (default stack)
SPA_WEB_HOST_PORT=3000
SPA_WEB_BIND_ADDRESS=127.0.0.1
BFF_PUBLIC_ORIGIN=http://spa-bff:3001
# SPA_WEB_IMAGE=ghcr.io/mycompany/okr-spa-web:2026-02-25
