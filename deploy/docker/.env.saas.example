# SaaS deployment template. Replace every CHANGE_ME value before use.
OKR_SAAS_MODE=true
OKR_DEPLOYMENT_PROFILE=single_tenant_saas
OKR_DATA_ACCESS_MODE=database
OKR_ENVIRONMENT_ID=CHANGE_ME_ENVIRONMENT_ID
OKR_CUSTOMER_ID=CHANGE_ME_CUSTOMER_ID
OKR_DATABASE_URL=postgresql+psycopg2://okr:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/okr
OKR_BACKUP_PROVIDER=CHANGE_ME_BACKUP_PROVIDER
OKR_BACKUP_SCHEDULE=CHANGE_ME_BACKUP_SCHEDULE
OKR_CONTROL_PLANE_STATE_PATH=/var/lib/okr/saas-control-plane.json
OKR_BACKEND_API_URL=http://backend-api:8100

# Runtime credentials must be injected by the deployment secret store.
OKR_BACKEND_SERVICE_TOKEN=CHANGE_ME_BACKEND_SERVICE_TOKEN
OKR_BACKEND_SIGNING_SECRET=CHANGE_ME_BACKEND_SIGNING_SECRET
OKR_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_BOOTSTRAP_ADMIN_PASSWORD
BFF_SESSION_SECRET=CHANGE_ME_BFF_SESSION_SECRET
BFF_COOKIE_SECURE=true
