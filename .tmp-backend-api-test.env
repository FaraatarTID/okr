PORT=8501
HOST_PORT=8501
BASE_URL_PATH=
OKR_DATABASE_URL=postgresql+psycopg2://okr_user:REPLACE_WITH_PASSWORD@127.0.0.1:5432/okr?sslmode=disable
OKR_BACKEND_API_URL=http://127.0.0.1:8100
OKR_BACKEND_SERVICE_TOKEN=REPLACE_WITH_SERVICE_TOKEN
OKR_BACKEND_SIGNING_SECRET=REPLACE_WITH_SIGNING_SECRET
BFF_SESSION_SECRET=REPLACE_WITH_SESSION_SECRET
OKR_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
OKR_BACKEND_ENFORCE_REQUEST_SIGNING=true
OKR_AUTH_ALLOW_THROTTLE_FAIL_OPEN=false
OKR_BACKEND_PROXY_MUTATIONS=true
OKR_BACKEND_PROXY_READS=true
OKR_BACKEND_SECURITY_STATE_BACKEND=database
OKR_BACKEND_SECURITY_STATE_REDIS_URL=
